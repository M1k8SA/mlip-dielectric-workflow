&CONTROL
    calculation='vc-relax'
    pseudo_dir='./pseudo/'
    outdir='./scratch/'
    prefix='B2N2'
    verbosity='low'
    tprnfor=.true.
    tstress=.true.
    etot_conv_thr=1e-05
    forc_conv_thr=0.0001
/

&SYSTEM
    ibrav=0
    nat=4
    ntyp=2
    occupations='fixed'
    smearing='fermi-dirac'
    degauss=0.01
    ecutwfc=60.0
/

&ELECTRONS
    diagonalization='david'
    mixing_beta=0.7
    conv_thr=1e-07
    diago_thr_init=0.0001
/

&IONS
/

&CELL
    cell_dofree='ibrav'
/

